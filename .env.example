# DFIR Memory Forensics Workbench — Environment Configuration Example
# Copy this file to .env and adjust values as needed.

# Secret key for Flask session cookie signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# If left empty, an ephemeral random key is generated at each server boot.
DFIR_SECRET_KEY=

# Optional API Key for REST API security (guards destructive actions and execution endpoints)
# If empty, transparent passthrough is active (suitable for local desktop/loopback development).
# If set, clients must pass either `X-API-Key: <key>` or `Authorization: Bearer <key>` header.
DFIR_API_KEY=

# Maximum upload file size in Megabytes (default: 65536 MB = 64 GB)
DFIR_MAX_UPLOAD_MB=65536

# Network Bind Configuration
HOST=127.0.0.1
PORT=8000
