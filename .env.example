# DFIR Memory Forensics Workbench — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Required for production / multi-user: a strong random secret (32+ bytes hex)
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
DFIR_SECRET_KEY=

# Optional: enable API-key authentication. When set, clients must send
#   X-API-Key: <value>   or   Authorization: Bearer <value>
# on all protected /api/* endpoints.
DFIR_API_KEY=

# Maximum memory-dump upload size in megabytes (default 65536 = 64 GB)
DFIR_MAX_UPLOAD_MB=65536

# Bind address and port (used by app.py and Docker)
HOST=127.0.0.1
PORT=8000
